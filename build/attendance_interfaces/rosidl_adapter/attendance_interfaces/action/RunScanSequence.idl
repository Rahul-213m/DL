      uint8 structure_needs_at_least_one_member;
    };
    @verbatim (language="comment", text=
      "Every action result in this package carries success, error_message and" "\n"
      "fault_code. `success` was COMMENTED OUT here, so the handler's" "\n"
      "`result.success = False` raised AttributeError inside the action server," "\n"
      "which ABORTED the goal and substituted a DEFAULT result: no message, no" "\n"
      "fault code, nothing to diagnose. Fourth instance of the same defect." "\n"
      "error_message and fault_code are declared further down, where their" "\n"
      "rationale is recorded.")
    struct RunScanSequence_Result {
      boolean success;

      string scan_id;

      @verbatim (language="comment", text=
        "Frames the sweep attempted and frames it accepted. A gap between them is a" "\n"
        "coverage problem and must be visible, not silently absorbed.")
      uint32 frames_attempted;

      uint32 frames_captured;

      uint32 frames_rejected;

      @verbatim (language="comment", text=
        "Regions re-visited because faces were too small or too blurry.")
      uint32 recapture_regions;

      double duration_s;

      string fault_code;

      @verbatim (language="comment", text=
        "Why. A bare fault code is not actionable to an operator standing in front" "\n"
        "of a classroom: \"plan_error\" tells them nothing about which room parameter" "\n"
        "is wrong.")

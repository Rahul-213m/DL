<?xml version="1.0"?>
<package format="3">
  <name>edge_uploader</name>
  <version>2.0.0</version>
  <description>
    Offline-first upload outbox: durable capture queue, resumable idempotent
    uploads, and bounded disk usage. The edge owns the data; the network is an
    optimisation.
  </description>
  <maintainer email="eng@example.invalid">Attendance Platform Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>attendance_interfaces</depend>
  <depend>python3-httpx</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>

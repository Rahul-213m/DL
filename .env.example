# ===========================================================================
# TEMPLATE ONLY. Copy to .env and fill in. NEVER commit a real .env.
#     cp .env.example .env
# Generate the secrets with:  python scripts/generate_secrets.py >> .env
# ===========================================================================

# ---------------------------------------------------------------------------
# ENVIRONMENT
# ---------------------------------------------------------------------------
# development | test | staging | production
# "staging" obeys every production guard rail. An unrecognised value is
# rejected rather than silently treated as development.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Dev only. Production uses PostgreSQL.
DATABASE_URL=sqlite:///./attendance.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# SQLite needs WAL and a busy timeout, or concurrent writers fail outright.
DB_SQLITE_WAL=true
DB_SQLITE_BUSY_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# OBJECT STORAGE
# ---------------------------------------------------------------------------
# local | s3. Production REQUIRES s3.
STORAGE_BACKEND=local
STORAGE_ROOT=data
ENROLLMENT_PHOTOS_ROOT=ENROLL_PHOTOS
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
# Never put credentials here in production; use an IAM role on the instance.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# REQUIRED in production: face images must use a customer-managed key (SSE-KMS),
# not provider-managed SSE-S3, so the customer controls the key lifecycle.
S3_KMS_KEY_ID=

# ---------------------------------------------------------------------------
# AUTHENTICATION  (NEVER COMMIT REAL VALUES)
# ---------------------------------------------------------------------------
# Bootstrap credential. Generate: python scripts/generate_secrets.py
# Must be >= 32 chars. The published default 'changeme-dev-key' is REFUSED
# in production and must be treated as compromised if it was ever deployed.
API_KEY=
# Signing key for human session tokens. Generate separately from API_KEY.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=28800
PASSWORD_HASH_ROUNDS=12
RATE_LIMIT_PER_MINUTE=240
DEVICE_TOKEN_TTL_SECONDS=31536000

# ---------------------------------------------------------------------------
# RECOGNITION THRESHOLDS
# ---------------------------------------------------------------------------
# Cosine similarity required to mark attendance unattended.
HIGH_CONFIDENCE_THRESHOLD=0.70
# Cosine similarity above which a candidate is proposed to an operator.
LOW_CONFIDENCE_THRESHOLD=0.35
# Minimum gap between best and runner-up gallery match. A small margin means
# the identity decision was ambiguous however high the top score is.
MATCH_MARGIN_THRESHOLD=0.08
# Detector confidence below which a face is discarded outright.
MIN_DETECTION_SCORE=0.50
# Hard pixel floor. The recognition TARGET is 80-112 px; this is the
# below-which-embeddings-are-meaningless floor, not a quality target.
MIN_FACE_SIZE_PX=40
# Faces narrower than this trigger a targeted re-capture request.
RESCAN_FACE_WIDTH_PX=64

# ---------------------------------------------------------------------------
# TILED INFERENCE (small back-row faces)
# ---------------------------------------------------------------------------
TILING_THRESHOLD_PX=2500
TILING_OVERLAP_RATIO=0.15
TILE_TARGET_SIDE_PX=1600
MAX_DETECTION_TILES=16

# ---------------------------------------------------------------------------
# FACE QUALITY GATES
# ---------------------------------------------------------------------------
# Variance-of-Laplacian floor; lower = blurrier. NOT a calibrated value --
# calibrate per camera with scripts/calibrate_quality.py.
MIN_SHARPNESS_SCORE=40.0
MAX_POSE_YAW_DEG=35.0
MAX_POSE_PITCH_DEG=25.0
MAX_POSE_ROLL_DEG=20.0
MIN_MEAN_LUMA=40.0
MIN_LUMA_STDDEV=15.0

# ---------------------------------------------------------------------------
# LIVENESS (anti-spoof). Separate model, separate purchase, separate licence.
# ---------------------------------------------------------------------------
LIVENESS_ENABLED=false

# ---------------------------------------------------------------------------
# INGESTION LIMITS
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=36000000
FRAMES_PER_CAPTURE=3

# ---------------------------------------------------------------------------
# JOB QUEUE
# ---------------------------------------------------------------------------
# memory | sqs. Production REQUIRES sqs (the in-memory queue loses jobs on
# restart and cannot span replicas).
JOB_QUEUE_BACKEND=memory
JOB_QUEUE_WORKERS=2
MAX_CONCURRENT_INFERENCE_JOBS=2
JOB_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
SQS_QUEUE_URL=
SQS_WAIT_TIME_SECONDS=20

# ---------------------------------------------------------------------------
# RETENTION (days). See docs/compliance.md.
# ---------------------------------------------------------------------------
RAW_FRAME_RETENTION_DAYS=30
FACE_CROP_RETENTION_DAYS=90
REVIEW_CONTEXT_RETENTION_DAYS=30
ENROLLMENT_PHOTO_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555

# ---------------------------------------------------------------------------
# MODELS  (see docs/model_licensing.md -- PRODUCTION BLOCKER)
# ---------------------------------------------------------------------------
# Comma-separated ONNX Runtime providers, best first.
#   CPU only:          CPUExecutionProvider
#   GPU production:    TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider
ONNX_PROVIDERS=CPUExecutionProvider
# Permissive baseline. Both are commercially usable.
DETECTOR_BACKEND=opencv_yunet
EMBEDDER_BACKEND=opencv_sface
# Optional JSON overlay recording a purchased licence without editing code.
MODEL_REGISTRY_CONFIG=
# InsightFace pack name. Only used by the NON-COMMERCIAL dev/benchmark backend.
MODEL_PACK_NAME=buffalo_l
INFERENCE_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=attendance-cloud

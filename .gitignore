# ---------------------------------------------------------------------------
# BIOMETRIC DATA — NEVER COMMIT
# ---------------------------------------------------------------------------
# Face crops, full classroom frames and review-context overlays are biometric
# personal data of third parties (students). They must never enter git.
# See docs/compliance.md (DPDP Act 2023 / GDPR).
data/
ENROLL_PHOTOS/
*.db
*.db.bak
*.db.pre_rectify
*.sqlite
*.sqlite3
archive/data/

# ---------------------------------------------------------------------------
# SECRETS — NEVER COMMIT
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
!docs/**/*.example

# ---------------------------------------------------------------------------
# PYTHON
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ---------------------------------------------------------------------------
# ROS 2
# ---------------------------------------------------------------------------
ros_ws/build/
ros_ws/install/
ros_ws/log/
ros_ws/src/**/__pycache__/

# ---------------------------------------------------------------------------
# ARCHIVES / LARGE BINARIES
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.7z
*.onnx
*.pt
*.pth
*.tflite

# ---------------------------------------------------------------------------
# TOOLING / IDE / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
*.log

# ---------------------------------------------------------------------------
# LOCAL RUNTIME STATE
# ---------------------------------------------------------------------------
ui/session_history.json
/tmp/
tmp/

# ROS 2 edge workspace build artifacts (ros_ws/ paths listed above too)
ros_ws/log/

# Real classroom photographs. Tracked since an early commit and containing
# EXIF GPS coordinates, which is location data about a school and its pupils.
# Removed from the index in W5 review; the files stay on disk. Purging them
# from history needs a human -- see docs/HUMAN_ACTIONS.md.
dummy_test/
# Any captured frame, at any stage of the pipeline.
**/images/
*.jpg
*.jpeg
*.png
*.onnx

# SQLAlchemy database URL used for structured attendance data.
DATABASE_URL=sqlite:///./attendance.db
# Root directory for private image and evidence storage.
STORAGE_ROOT=data
# Directory containing one enrollment-photo folder per roll number.
ENROLL_PHOTOS_ROOT=ENROLL_PHOTOS
# Cosine-similarity score required for automatic attendance marking.
HIGH_CONFIDENCE_THRESHOLD=0.70
# Maximum number of images mirrored into ENROLL_PHOTOS/<roll_no>. Embeddings in
# SQLite continue to grow after this local-storage limit is reached.
MAX_ENROLLMENT_PHOTOS_PER_STUDENT=15
# Cosine-similarity score at which operator review becomes eligible.
LOW_CONFIDENCE_THRESHOLD=0.35
# Maximum allowed uploaded image size, in bytes.
MAX_UPLOAD_BYTES=10485760
# Number of days to retain session frames and face crops.
RAW_FRAME_RETENTION_DAYS=30
# InsightFace model package used for detection and embeddings.
INSIGHTFACE_MODEL=buffalo_l
# Comma-separated ONNX Runtime execution providers.
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
# Shared API key; this default must be overridden in production.
API_KEY=changeme-dev-key
# Minimum detected-face width and height, in pixels.
MIN_FACE_SIZE_PX=40
# Frame dimension threshold above which 2x2 tiled detection is enabled.
TILING_THRESHOLD_PX=2500
# Fractional overlap between adjacent detection tiles.
TILING_OVERLAP_RATIO=0.15

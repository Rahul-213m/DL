<?xml version="1.0"?>
<!--
  attendance_stand.urdf.xacro

  Simulated Attendance Camera Stand Robot

  Physical layout (bottom to top):

      BASE (fixed to table)
        |
   ROTATING PLATFORM (spins horizontally around Z axis)
        |
   PHONE HOLDER (vertical arm)
        |
      PHONE (smartphone box)

  The rotating_joint revolves around axis Z (0 0 1),
  enabling 360-degree horizontal classroom scanning.

  Dimensions for a small tabletop phone stand:
    Base:     0.12m x 0.12m x 0.04m
    Platform: 0.10m diameter disk, 0.01m tall
    Holder:   0.02m x 0.02m x 0.20m vertical arm
    Phone:    0.075m x 0.008m x 0.155m (typical smartphone)
-->
<robot name="attendance_stand" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       MATERIAL DEFINITIONS
       ============================================================ -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="phone_blue">
    <color rgba="0.1 0.3 0.7 1.0"/>
  </material>

  <!-- ============================================================
       INERTIA MACROS
       ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y + z*z)/12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${m*(x*x + z*z)/12.0}"
        iyz="0.0"
        izz="${m*(x*x + y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r + h*h)/12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${m*(3*r*r + h*h)/12.0}"
        iyz="0.0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       XACRO PROPERTIES  (edit dimensions here)
       ============================================================ -->
  <!-- Base -->
  <xacro:property name="base_x"       value="0.12"/>
  <xacro:property name="base_y"       value="0.12"/>
  <xacro:property name="base_z"       value="0.04"/>
  <xacro:property name="base_mass"    value="0.5"/>

  <!-- Rotating platform (thin disk modelled as cylinder) -->
  <xacro:property name="platform_r"    value="0.05"/>
  <xacro:property name="platform_h"    value="0.01"/>
  <xacro:property name="platform_mass" value="0.1"/>

  <!-- Vertical holder arm -->
  <xacro:property name="holder_x"      value="0.02"/>
  <xacro:property name="holder_y"      value="0.02"/>
  <xacro:property name="holder_z"      value="0.20"/>
  <xacro:property name="holder_mass"   value="0.1"/>

  <!-- Phone dimensions -->
  <xacro:property name="phone_x"       value="0.075"/>
  <xacro:property name="phone_y"       value="0.008"/>
  <xacro:property name="phone_z"       value="0.155"/>
  <xacro:property name="phone_mass"    value="0.18"/>

  <!-- ============================================================
       LINK: base_link  (fixed to world / table surface)
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}"/>
  </link>

  <!-- ============================================================
       JOINT: rotating_joint
       This is the primary joint. Revolute around Z-axis for
       horizontal scanning of the classroom.
       ============================================================ -->
  <joint name="rotating_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotating_platform"/>
    <!-- Origin sits on top of the base -->
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
    <!-- Rotation axis: Z vertical = horizontal platform spin -->
    <axis xyz="0 0 1"/>
    <!-- Allow nearly full 360 degrees (pi = ~180 degrees each way) -->
    <limit lower="-3.14159265" upper="3.14159265" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- ============================================================
       LINK: rotating_platform  (spins with the joint)
       ============================================================ -->
  <link name="rotating_platform">
    <visual>
      <origin xyz="0 0 ${platform_h/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${platform_r}" length="${platform_h}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${platform_h/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${platform_r}" length="${platform_h}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${platform_mass}" r="${platform_r}" h="${platform_h}"/>
  </link>

  <!-- ============================================================
       JOINT: holder_joint  (fixed, holder mounts on platform)
       ============================================================ -->
  <joint name="holder_joint" type="fixed">
    <parent link="rotating_platform"/>
    <child link="phone_holder"/>
    <origin xyz="0 0 ${platform_h}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       LINK: phone_holder  (vertical arm)
       ============================================================ -->
  <link name="phone_holder">
    <visual>
      <origin xyz="0 0 ${holder_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${holder_x} ${holder_y} ${holder_z}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${holder_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${holder_x} ${holder_y} ${holder_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${holder_mass}" x="${holder_x}" y="${holder_y}" z="${holder_z}"/>
  </link>

  <!-- ============================================================
       JOINT: phone_joint  (fixed, phone mounted on top of holder)
       ============================================================ -->
  <joint name="phone_joint" type="fixed">
    <parent link="phone_holder"/>
    <child link="phone"/>
    <!-- Sit at the top of the holder, slightly forward in Y -->
    <origin xyz="0 0.01 ${holder_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       LINK: phone  (represents the smartphone)
       ============================================================ -->
  <link name="phone">
    <visual>
      <origin xyz="0 0 ${phone_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${phone_x} ${phone_y} ${phone_z}"/>
      </geometry>
      <material name="phone_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${phone_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${phone_x} ${phone_y} ${phone_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${phone_mass}" x="${phone_x}" y="${phone_y}" z="${phone_z}"/>
  </link>

</robot>

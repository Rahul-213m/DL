    and a fully simulated one, selected by a single argument.
  </description>
  <maintainer email="eng@example.invalid">Attendance Platform Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>attendance_interfaces</exec_depend>
